[Unit]
Description=NpuCamFX top-bar control
After=graphical-session.target npu-effects.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/npu-effects-indicator
Environment=GI_TYPELIB_PATH=%h/.local/lib/npu-camera-effects/girepository-1.0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
